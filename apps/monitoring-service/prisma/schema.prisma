generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/monitoring-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MONITORING_DATABASE_URL")
}

model CallTelemetryEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  attemptId   String   @map("attempt_id")
  callId      String?  @map("call_id")
  role        String?
  eventType   String   @map("event_type")
  stage       String
  outcome     String?
  elapsedMs   Int      @map("elapsed_ms")
  occurredAt  DateTime @map("occurred_at")
  platform    String
  appVersion  String   @map("app_version")
  osVersion   String?  @map("os_version")
  direction   String?
  errorCode   String?  @map("error_code")
  metricsJson Json?    @map("metrics_json")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@index([platform, appVersion, eventType])
  @@index([callId, occurredAt])
  @@map("call_telemetry_events")
}

model RecommendationTelemetryEvent {
  id                 String   @id @default(uuid())
  eventId            String   @unique @map("event_id")
  recommendationType String   @map("recommendation_type")
  algorithmVersion   String   @map("algorithm_version")
  feedSessionId      String   @map("feed_session_id")
  route              String
  candidateSource    String   @map("candidate_source")
  requestedLimit     Int      @map("requested_limit")
  returnedItems      Int      @map("returned_items")
  latencyMs          Int      @map("latency_ms")
  outcome            String
  errorCode          String?  @map("error_code")
  featureFlags       Json     @map("feature_flags")
  occurredAt         DateTime @map("occurred_at")
  receivedAt         DateTime @default(now()) @map("received_at")

  @@index([occurredAt])
  @@index([recommendationType, algorithmVersion, outcome])
  @@index([candidateSource, occurredAt])
  @@index([feedSessionId])
  @@index([route, occurredAt])
  @@map("recommendation_telemetry_events")
}