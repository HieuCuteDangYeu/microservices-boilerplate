generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/reel-indexing-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("REEL_INDEXING_DATABASE_URL")
}

enum IndexJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum IndexCheckpointStage {
  TRANSCRIBING_AUDIO_SEGMENTS
  MERGING_TRANSCRIPT
  EXTRACTING_METADATA
  BUILDING_SECTIONS
  BUILDING_CHUNKS
  EMBEDDING
  VALIDATING
  PERSISTING
}

enum AudioSegmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IndexDocumentKind {
  REEL
  SECTION
  CHUNK
}

model IndexingAttempt {
  indexAttemptId    String               @id
  jobId             String               @unique
  reelId            String
  mediaAttemptId    String
  indexVersion      String
  status            IndexJobStatus       @default(PROCESSING)
  stage             IndexCheckpointStage @default(TRANSCRIBING_AUDIO_SEGMENTS)
  mergedTranscript  String?              @db.Text
  mergedSegments    Json?
  extractedMetadata Json?
  sections          Json?
  chunks            Json?
  lastError         String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  audioSegments AudioSegmentCheckpoint[]

  @@index([reelId])
  @@index([status, updatedAt])
}

model EmbeddingCacheEntry {
  cacheKey            String            @id
  stableItemId        String
  documentKind        IndexDocumentKind
  embeddingInputHash  String
  embeddingProvider   String
  embeddingModel      String
  embeddingDimensions Int
  embeddingVersion    String
  indexVersion        String
  chunkingVersion     String
  summaryVersion      String
  embedding           Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([stableItemId])
  @@index([embeddingInputHash, embeddingVersion])
  @@index([indexVersion, chunkingVersion, summaryVersion])
}

model AudioSegmentCheckpoint {
  id                   String             @id @default(uuid())
  indexAttemptId       String
  segmentNumber        Int
  artifactKey          String
  artifactChecksum     String
  startMs              Int
  endMs                Int
  overlapBeforeMs      Int
  provider             String?
  transcriptionModel   String?
  transcriptionVersion String?
  status               AudioSegmentStatus @default(PENDING)
  attemptCount         Int                @default(0)
  transcriptText       String?            @db.Text
  transcriptSegments   Json?
  lastError            String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  checkpoint IndexingAttempt @relation(fields: [indexAttemptId], references: [indexAttemptId], onDelete: Cascade)

  @@unique([indexAttemptId, segmentNumber])
  @@index([indexAttemptId, status])
}

model ReelDocument {
  rowId               String                     @id @default(uuid())
  id                  String
  reelId              String
  indexAttemptId      String
  isActive            Boolean                    @default(false)
  userId              String
  parentId            String?
  title               String?
  description         String?                    @db.Text
  text                String                     @db.Text
  tags                String[]
  startTime           Float?
  endTime             Float?
  sourceDurationMs    Int
  sourceOrientation   String
  sourceLengthClass   String
  embedding           Unsupported("vector(384)")
  searchVector        Unsupported("tsvector")?
  embeddingProvider   String
  embeddingModel      String
  embeddingDimensions Int
  embeddingVersion    String
  embeddingInputHash  String
  indexVersion        String
  chunkingVersion     String
  summaryVersion      String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([id, indexAttemptId])
  @@unique([reelId, indexAttemptId])
  @@index([reelId, isActive])
  @@index([userId, isActive])
  @@index([sourceLengthClass, isActive])
}

model ReelSection {
  rowId               String                     @id @default(uuid())
  id                  String
  reelId              String
  indexAttemptId      String
  isActive            Boolean                    @default(false)
  userId              String
  parentId            String
  title               String?
  description         String?                    @db.Text
  text                String                     @db.Text
  tags                String[]
  startTime           Float
  endTime             Float
  sourceDurationMs    Int
  sourceOrientation   String
  sourceLengthClass   String
  embedding           Unsupported("vector(384)")
  searchVector        Unsupported("tsvector")?
  embeddingProvider   String
  embeddingModel      String
  embeddingDimensions Int
  embeddingVersion    String
  embeddingInputHash  String
  indexVersion        String
  chunkingVersion     String
  summaryVersion      String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([id, indexAttemptId])
  @@index([reelId, isActive])
  @@index([parentId, isActive])
  @@index([userId, isActive])
}

model ReelChunk {
  rowId               String                     @id @default(uuid())
  id                  String
  reelId              String
  indexAttemptId      String
  isActive            Boolean                    @default(false)
  userId              String
  parentId            String
  title               String?
  description         String?                    @db.Text
  text                String                     @db.Text
  tags                String[]
  startTime           Float?
  endTime             Float?
  sourceDurationMs    Int
  sourceOrientation   String
  sourceLengthClass   String
  embedding           Unsupported("vector(384)")
  searchVector        Unsupported("tsvector")?
  embeddingProvider   String
  embeddingModel      String
  embeddingDimensions Int
  embeddingVersion    String
  embeddingInputHash  String
  indexVersion        String
  chunkingVersion     String
  summaryVersion      String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([id, indexAttemptId])
  @@index([reelId, isActive])
  @@index([parentId, isActive])
  @@index([userId, isActive])
}

model TranscriptionSegment {
  id             String   @id @default(uuid())
  reelId         String
  indexAttemptId String
  ordinal        Int
  startTime      Float
  endTime        Float
  text           String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([indexAttemptId, ordinal])
  @@index([reelId, indexAttemptId])
}
