generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/ai-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("AI_DATABASE_URL")
}

enum UserMemoryType {
  PREFERENCE
  PROFILE
  TECHNICAL_CONTEXT
  COMMUNICATION_STYLE
  OTHER
}

model UserMemory {
  id                   String         @id @default(uuid())
  userId               String
  type                 UserMemoryType
  content              String         @db.Text
  normalizedContent    String         @db.Text
  confidence           Float          @default(0.7)
  sourceConversationId String?
  embedding            Unsupported("vector(384)")?
  embeddingModel       String?
  lastUsedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([type])
  @@index([updatedAt])
  @@index([userId, embeddingModel])
  @@unique([userId, type, normalizedContent])
}

model ConversationMemory {
  id             String   @id @default(uuid())
  conversationId String   @unique
  userId         String
  summary        String   @db.Text
  messageCount   Int      @default(0)
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model RagTrace {
  id String @id @default(uuid())

  userId         String
  conversationId String
  message        String @db.Text

  intent         String?
  needsRetrieval Boolean @default(false)

  retrievedChunkIds Json?
  rerankedChunkIds  Json?
  citations         Json?

  answer             String? @db.Text
  verifierPassed     Boolean?
  verifierConfidence Float?
  verifierIssues     Json?

  latencyMs       Int?
  nodeTimings      Json?
  workflowMetrics Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
}

model RagHierarchyShadowObservation {
  id String @id @default(uuid())

  userId         String
  conversationId String
  queryText      String @db.Text
  retrievalMode  String
  requiredEvidence String[]

  directChunkIds       Json
  hierarchicalChunkIds Json
  directCount           Int
  hierarchicalCount     Int
  directMs              Int
  hierarchicalMs        Int
  overlapAtK            Float
  jaccard               Float

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}
