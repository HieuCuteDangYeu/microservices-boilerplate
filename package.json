{
  "name": "microservices-boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "pnpm prisma:generate:all",
    "build": "nest build",
    "test": "jest",
    "test:e2e": "jest --runInBand apps/call-service/test/call-flow.e2e.spec.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start:gateway": "nest start api-gateway --watch",
    "start:user": "nest start user-service --watch",
    "start:friend": "nest start friend-service --watch",
    "start:auth": "nest start auth-service --watch",
    "start:mail": "nest start mail-service --watch",
    "start:media": "nest start media-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:conversation": "nest start conversation-service --watch",
    "start:call": "nest start call-service --watch",
    "start:monitoring": "nest start monitoring-service --watch",
    "start:content": "nest start content-service --watch",
    "start:media-processing": "nest start media-processing-service --watch",
    "start:prod:media-processing": "node dist/apps/media-processing-service/main.js",
    "start:ai": "nest start ai-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start": "pnpm start:all",
    "start:all": "concurrently -c \"cyan.bold,magenta.bold,yellow.bold,red.bold,green.bold,blue.bold\" \"pnpm start:gateway\" \"pnpm start:user\" \"pnpm start:friend\" \"pnpm start:auth\" \"pnpm start:mail\" \"pnpm start:media\" \"pnpm start:payment\" \"pnpm start:conversation\" \"pnpm start:call\" \"pnpm start:monitoring\" \"pnpm start:content\" \"pnpm start:media-processing\" \"pnpm start:ai\" \"pnpm start:notification\"",
    "build:gateway": "nest build api-gateway",
    "build:user": "nest build user-service",
    "build:friend": "nest build friend-service",
    "build:auth": "nest build auth-service",
    "build:mail": "nest build mail-service",
    "build:media": "nest build media-service",
    "build:payment": "nest build payment-service",
    "build:conversation": "nest build conversation-service",
    "build:call": "nest build call-service",
    "build:monitoring": "nest build monitoring-service",
    "build:content": "nest build content-service",
    "build:media-processing": "nest build media-processing-service",
    "build:ai": "nest build ai-service",
    "build:notification": "nest build notification-service",
    "build:all": "pnpm run build:gateway && pnpm run build:user && pnpm run build:friend && pnpm run build:auth && pnpm run build:mail && pnpm run build:media && pnpm run build:payment && pnpm run build:conversation && pnpm run build:call && pnpm run build:monitoring && pnpm run build:content && pnpm run build:media-processing && pnpm run build:ai && pnpm run build:notification",
    "prisma:generate:user": "prisma generate --schema=apps/user-service/prisma/schema.prisma",
    "prisma:generate:friend": "prisma generate --schema=apps/friend-service/prisma/schema.prisma",
    "prisma:generate:auth": "prisma generate --schema=apps/auth-service/prisma/schema.prisma",
    "prisma:generate:payment": "prisma generate --schema=apps/payment-service/prisma/schema.prisma",
    "prisma:generate:conversation": "prisma generate --schema=apps/conversation-service/prisma/schema.prisma",
    "prisma:generate:content": "prisma generate --schema=apps/content-service/prisma/schema.prisma",
    "migrate:dev:content": "prisma migrate dev --schema=apps/content-service/prisma/schema.prisma",
    "migrate:deploy:content": "prisma migrate deploy --schema=apps/content-service/prisma/schema.prisma",
    "prisma:generate:ai": "prisma generate --schema=apps/ai-service/prisma/schema.prisma",
    "prisma:generate:notification": "prisma generate --schema=apps/notification-service/prisma/schema.prisma",
    "prisma:generate:monitoring": "prisma generate --schema=apps/monitoring-service/prisma/schema.prisma",
    "prisma:generate:all": "pnpm run prisma:generate:user && pnpm run prisma:generate:friend && pnpm run prisma:generate:auth && pnpm run prisma:generate:payment && pnpm run prisma:generate:conversation && pnpm run prisma:generate:content && pnpm run prisma:generate:ai && pnpm run prisma:generate:notification && pnpm run prisma:generate:monitoring",
    "migrate:user": "cd apps/user-service && prisma migrate dev",
    "migrate:friend": "cd apps/friend-service && prisma migrate dev",
    "migrate:auth": "cd apps/auth-service && prisma migrate dev",
    "migrate:payment": "cd apps/payment-service && prisma migrate dev",
    "migrate:conversation": "cd apps/conversation-service && prisma db push",
    "migrate:content": "cd apps/content-service && prisma migrate dev",
    "migrate:ai": "cd apps/ai-service && prisma migrate dev",
    "migrate:notification": "cd apps/notification-service && prisma migrate dev",
    "migrate:monitoring": "cd apps/monitoring-service && prisma migrate dev",
    "studio:user": "cd apps/user-service && prisma studio",
    "studio:friend": "cd apps/friend-service && prisma studio",
    "studio:auth": "cd apps/auth-service && prisma studio",
    "studio:payment": "cd apps/payment-service && prisma studio",
    "studio:conversation": "cd apps/conversation-service && prisma studio",
    "studio:content": "cd apps/content-service && prisma studio",
    "studio:ai": "cd apps/ai-service && prisma studio",
    "studio:notification": "cd apps/notification-service && prisma studio",
    "seed:auth": "dotenv -e .env -- ts-node apps/auth-service/prisma/seed.ts",
    "seed:user": "dotenv -e .env -- ts-node apps/user-service/prisma/seed.ts",
    "seed:all": "pnpm run seed:auth && pnpm run seed:user",
    "purge:content-reels": "node scripts/purge-content-reels.cjs",
    "backfill:conversation-client-message-ids": "node scripts/backfill-conversation-client-message-ids.cjs",
    "backfill:reel-chunks": "node scripts/send-rmq-message.cjs content_queue content.backfill_reel_chunks '{\"limit\":20}'",
    "backfill:user-memory-embeddings": "node scripts/send-rmq-message.cjs ai_queue ai.backfill_user_memory_embeddings '{\"limit\":100}'",
    "tmp:load-test:reel-pipeline": "node scripts/tmp/load-test-reel-pipeline.cjs",
    "tmp:inspect:media-output": "node scripts/tmp/inspect-media-output.cjs",
    "tmp:test:reel-pipeline": "jest --runInBand apps/media-processing-service/src/application/use-cases/classify-reel-media.use-case.spec.ts apps/media-processing-service/src/application/use-cases/media-processing.phase3.spec.ts apps/media-processing-service/src/infrastructure/services/ffmpeg.service.phase3.spec.ts apps/media-processing-service/src/infrastructure/services/processing-metrics.service.spec.ts scripts/tmp/load-test-reel-pipeline.spec.ts",
    "tmp:inspect:reel-queues": "node scripts/tmp/inspect-reel-queues.cjs",
    "tmp:failure-test:reel-queues": "node scripts/tmp/failure-test-reel-queues.cjs",
    "tmp:test:reel-queues": "jest --runInBand apps/content-service/src/application/use-cases/create-reel-outbox.use-case.spec.ts apps/content-service/src/application/use-cases/classify-reel-job-length.use-case.spec.ts apps/content-service/src/application/use-cases/dispatch-outbox-events.use-case.spec.ts apps/content-service/src/application/use-cases/claim-reel-processing-attempt.use-case.spec.ts apps/media-processing-service/src/application/use-cases/validate-reel-source-media.use-case.phase1.spec.ts apps/media-processing-service/src/infrastructure/controllers/media-processing.controller.phase1.spec.ts scripts/tmp/reel-queue-tools.spec.ts",
    "tmp:test:reel-state": "jest --runInBand apps/media-processing-service/src/application/use-cases/classify-reel-media.use-case.spec.ts apps/content-service/src/domain/reel-status-compatibility.mapper.phase2.spec.ts apps/content-service/src/infrastructure/repositories/content.repository.phase2.spec.ts"
  },
  "packageManager": "pnpm@9.15.0",
  "overrides": {
    "sharp": "^0.33.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.12",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/websockets": "^11.1.12",
    "@prisma/client": "5.22.0",
    "@smithy/node-http-handler": "^4.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.6.1",
    "ioredis": "^5.8.2",
    "mediasoup": "^3.14.20",
    "mongoose": "^9.1.4",
    "nestjs-zod": "^5.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pnpm": "9.15.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.3",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^20.1.0",
    "wavefile": "^11.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "5.22.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
