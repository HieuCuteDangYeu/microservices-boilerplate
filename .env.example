# Cloudflare credentials (secrets must be supplied outside source control)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ENABLED=true
CLOUDFLARE_AI_GATEWAY_ID=default
CLOUDFLARE_STRUCTURED_REASONING_EFFORT=low

# Typed semantic model roles
AI_ROUTER_MODEL=@cf/zai-org/glm-4.7-flash
AI_RETRIEVAL_PLANNER_MODEL=@cf/zai-org/glm-4.7-flash
AI_RETRIEVAL_TOOL_MODEL=@cf/zai-org/glm-4.7-flash
AI_CONTEXT_SUFFICIENCY_MODEL=@cf/openai/gpt-oss-20b
AI_ANSWER_MODEL=@cf/zai-org/glm-4.7-flash
AI_ANSWER_REVISION_MODEL=@cf/openai/gpt-oss-20b
AI_VERIFIER_MODEL=@cf/openai/gpt-oss-20b
AI_VERIFIER_ESCALATION_MODEL=@cf/openai/gpt-oss-120b
AI_CITATION_ATTRIBUTION_MODEL=@cf/openai/gpt-oss-20b
AI_INDEX_QUALITY_MODEL=@cf/openai/gpt-oss-20b
AI_METADATA_EXTRACTION_MODEL=@cf/zai-org/glm-4.7-flash
AI_SECTION_SUMMARY_MODEL=@cf/zai-org/glm-4.7-flash
AI_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
AI_VISION_VERSION=cf-llama-4-scout-vision-2026-08
AI_TRANSCRIPTION_MODEL=@cf/openai/whisper-large-v3-turbo
AI_TRANSCRIPTION_VERSION=cf-whisper-large-v3-turbo-2026-08
AI_EMBEDDING_MODEL=@cf/baai/bge-m3
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_VERSION=cf-bge-m3-v1
AI_RERANKER_MODEL=@cf/baai/bge-reranker-base
AI_CONVERSATION_SUMMARY_MODEL=@cf/zai-org/glm-4.7-flash
AI_MEMORY_EXTRACTION_MODEL=@cf/zai-org/glm-4.7-flash

# Bounded role policy
AI_ROUTER_TIMEOUT_MS=8000
AI_RETRIEVAL_PLANNER_TIMEOUT_MS=8000
AI_RETRIEVAL_TOOL_TIMEOUT_MS=8000
AI_CONTEXT_SUFFICIENCY_TIMEOUT_MS=12000
AI_ANSWER_TIMEOUT_MS=30000
AI_ANSWER_REVISION_TIMEOUT_MS=30000
AI_VERIFIER_TIMEOUT_MS=12000
AI_VERIFIER_MAX_TOKENS=650
AI_VERIFIER_ESCALATION_MAX_TOKENS=1024
AI_VERIFIER_ESCALATION_TIMEOUT_MS=30000
AI_CITATION_TIMEOUT_MS=12000
AI_VISION_TIMEOUT_MS=30000
AI_TRANSCRIPTION_TIMEOUT_MS=60000
AI_EMBEDDING_TIMEOUT_MS=12000
AI_RAG_NEURAL_RERANK_TIMEOUT_MS=5000
AI_VERIFIER_ESCALATION_ENABLED=true
AI_VERIFIER_ESCALATION_CONFIDENCE_THRESHOLD=0.80
AI_VERIFIER_MAX_ATTEMPTS=2
AI_RERANKER_MAX_INPUT_TOKENS=512

# Index identity. Reindexing and activation are explicit operations.
INDEX_TRANSCRIPTION_PROVIDER=cloudflare-workers-ai
INDEX_EMBEDDING_CONCURRENCY=4
