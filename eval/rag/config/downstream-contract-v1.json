    "verifier-bounded": [
      "verifier-01",
      "verifier-02",
      "verifier-03",
      "verifier-04",
      "verifier-05",
      "verifier-06"
    ]
  },
  "calibrationReuseInFullComparison": false,
  "downstreamContract": "Context-sufficiency-v2 and verifier evidence mappings use stable positional evidence IDs supplied in each prompt"
}
