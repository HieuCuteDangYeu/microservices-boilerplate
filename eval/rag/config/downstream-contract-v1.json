{
  "schemaVersion": "rag-candidate-config-v1",
  "variantName": "downstream-contract-v1",
  "datasetVersion": "rag-generalization-v1",
  "pricingVersion": "cloudflare-workers-ai-2026-08-30-v1",
  "source": "Offline downstream context-sufficiency and verifier contract validation; router selection remains frozen",
  "providerContract": "CHAT_JSON_SCHEMA",
  "providerEndpoint": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1/chat/completions",
  "routerSchemaVersion": "router-semantic-v4",
  "modelDocumentation": {
    "verifiedDate": "2026-08-30",
    "candidate": {
      "model": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "jsonMode": true,
      "nativeAiRun": true,
      "openAiCompatibleChat": true,
      "tokenParameter": "max_tokens",
      "reasoningEffortParameter": "omitted"
    }
  },
  "env": {
    "AI_ROUTER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_ROUTER_FALLBACK_MODEL": "",
    "AI_ROUTER_TIMEOUT_MS": "30000",
    "AI_ROUTER_FALLBACK_TIMEOUT_MS": "30000",
    "AI_ROUTER_MAX_TOKENS": "512",
    "AI_ROUTER_FALLBACK_MAX_TOKENS": "512",
    "AI_CONTEXT_SUFFICIENCY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_CONTEXT_SUFFICIENCY_TIMEOUT_MS": "30000",
    "AI_CONTEXT_SUFFICIENCY_MAX_TOKENS": "512",
    "AI_VERIFIER_MODEL": "@cf/openai/gpt-oss-20b",
    "AI_VERIFIER_TIMEOUT_MS": "12000",
    "AI_VERIFIER_MAX_TOKENS": "650",
    "CLOUDFLARE_STRUCTURED_REASONING_EFFORT": "",
