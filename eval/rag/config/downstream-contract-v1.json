    "CLOUDFLARE_AI_GATEWAY_ENABLED": "false",
    "CLOUDFLARE_AI_GATEWAY_MAX_ATTEMPTS": "1",
    "CLOUDFLARE_ROUTER_OUTPUT_CONTRACT": "CHAT_JSON_SCHEMA"
  },
  "experimentOverrides": {
    "routerFallbackDisabled": true,
    "stopOnTruncation": true,
