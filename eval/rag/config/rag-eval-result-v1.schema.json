{
  "$defs": {
    "ModelCall": {
      "additionalProperties": true,
      "properties": {
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "finishReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finishreason"
        },
        "inputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputtokens"
        },
        "latencyMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latencyms"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "modelRole": {
          "title": "Modelrole",
          "type": "string"
        },
        "outputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputtokens"
        },
        "providerCategory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providercategory"
        },
        "providerStatus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": ["NETWORK_ERROR", "TIMEOUT"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerstatus"
        },
        "scope": {
          "default": "QUERY",
          "enum": ["QUERY", "INDEXING", "EVALUATION_JUDGE"],
          "title": "Scope",
          "type": "string"
        },
        "totalTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Totaltokens"
        },
        "usageSource": {
          "enum": ["PROVIDER", "ESTIMATED", "UNAVAILABLE"],
          "title": "Usagesource",
          "type": "string"
        }
      },
      "required": ["modelRole", "model", "usageSource"],
      "title": "ModelCall",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "actual": {
      "additionalProperties": true,
      "title": "Actual",
      "type": "object"
    },
    "caseId": {
      "title": "Caseid",
      "type": "string"
    },
    "executionStatus": {
      "enum": [
        "COMPLETED",
        "FIXTURE",
        "PROVIDER_FAILURE",
        "NO_RESPONSE",
        "ROUTER_UNAVAILABLE",
        "RECONCILED_FAILURE"
      ],
      "title": "Executionstatus",
      "type": "string"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "latencyMs": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latencyms"
    },
    "modelCalls": {
      "items": {
        "$ref": "#/$defs/ModelCall"
      },
      "title": "Modelcalls",
      "type": "array"
    },
    "reference": {
      "additionalProperties": true,
      "title": "Reference",
      "type": "object"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "rag-eval-result-v1",
      "default": "rag-eval-result-v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "trace": {
      "additionalProperties": true,
      "title": "Trace",
      "type": "object"
    },
    "variant": {
      "additionalProperties": true,
      "title": "Variant",
      "type": "object"
    }
  },
  "required": [
    "runId",
    "caseId",
    "executionStatus",
    "input",
    "reference",
    "actual"
  ],
  "title": "NormalizedExecutionResult",
  "type": "object"
}
