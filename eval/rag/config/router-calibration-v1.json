{
  "schemaVersion": "rag-candidate-config-v1",
  "variantName": "router-calibration-45s-v1",
  "datasetVersion": "rag-generalization-v1",
  "source": "Tracked .env.example candidate; local .env and deployed runtime are not overwritten or inferred",
  "env": {
    "AI_ROUTER_MODEL": "@cf/openai/gpt-oss-20b",
    "AI_ROUTER_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_ROUTER_TIMEOUT_MS": "45000",
    "AI_ROUTER_FALLBACK_TIMEOUT_MS": "60000",
    "AI_ROUTER_MAX_TOKENS": "2048",
    "CLOUDFLARE_STRUCTURED_REASONING_EFFORT": "low",
    "CLOUDFLARE_AI_GATEWAY_ENABLED": "false",
    "CLOUDFLARE_AI_GATEWAY_MAX_ATTEMPTS": "1"
  },
  "experimentOverrides": {
    "routerFallbackDisabled": true,
    "aiGatewayReason": "Direct provider calibration, no gateway retries; credentials env has no gateway ID"
  },
  "subsets": {
    "harness": [
      "explicit-01",
      "implicit-01",
      "normal-01",
      "discovery-01",
      "conversation-01",
      "multi-02"
    ],
    "latency": [
      "explicit-02",
      "explicit-03",
      "explicit-04",
      "implicit-06",
      "implicit-08",
      "normal-04",
      "discovery-02",
      "memory-02",
      "task-01",
      "multi-03"
    ]
  },
  "calibrationReuseInFullComparison": false,
  "harnessGate": "All 6 per model produce exactly one structurally valid completion; labels reported separately",
  "latencyGate": "All 10 per model structurally complete, p95 and max below 80 percent of 45000 ms"
}
