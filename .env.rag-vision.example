# RAG / retrieval / memory / visual-index feature environment
# Copy the relevant values into your local root .env.
# Do not commit real credentials.

# -----------------------------------------------------------------------------
# Required existing service prerequisites
# -----------------------------------------------------------------------------
# PostgreSQL databases used by reel-indexing and ai-service.
REEL_INDEXING_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/reel_indexing
AI_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai

# Cloudflare Workers AI credentials used by transcription/vision adapters.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Gemini embeddings. Keep 384 to match pgvector columns/HNSW indexes.
GEMINI_API_KEY=
GEMINI_EMBEDDING_DIMENSIONS=384

# R2 artifact storage used by media-processing/reel-indexing.
# The S3-compatible endpoint is derived automatically from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Existing public CDN/domain value may still be used by media/content services
# for public object URLs; it is not the S3 API endpoint.
R2_PUBLIC_DOMAIN=https://cdn.example.com

# FFmpeg must be executable. Leave blank when `ffmpeg` is already on PATH.
FFMPEG_PATH=/usr/bin/ffmpeg

# -----------------------------------------------------------------------------
# Citation / retrieval rollout
# -----------------------------------------------------------------------------
# Keep production result selection on direct retrieval while comparing the
# hierarchical path in logs.
RAG_HIERARCHICAL_RETRIEVAL_ENABLED=false
RAG_HIERARCHICAL_RETRIEVAL_SHADOW_ENABLED=true

# -----------------------------------------------------------------------------
# Adaptive long-reel sectioning rollout
# -----------------------------------------------------------------------------
INDEX_LONG_ADAPTIVE_SECTIONING_ENABLED=false
INDEX_LONG_ADAPTIVE_SECTIONING_SHADOW_MODE=true
INDEX_LONG_ADAPTIVE_SECTIONING_SHADOW_SAMPLE_RATE=0.10
INDEX_SECTION_BOUNDARY_EVAL_TOLERANCE_SECONDS=15

# Existing adaptive-section defaults, made explicit for reproducible testing.
INDEX_LONG_SECTION_MIN_SECONDS=120
INDEX_LONG_SECTION_TARGET_SECONDS=300
INDEX_LONG_SECTION_MAX_SECONDS=480
INDEX_LONG_SECTION_CANDIDATE_PAUSE_MS=1500
INDEX_SECTION_BOUNDARY_THRESHOLD=0.38
INDEX_SECTION_SEMANTIC_WEIGHT=0.55
INDEX_SECTION_PAUSE_WEIGHT=0.20
INDEX_SECTION_LEXICAL_WEIGHT=0.15
INDEX_SECTION_DURATION_WEIGHT=0.10
INDEX_SECTION_EMBEDDING_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Reranking
# -----------------------------------------------------------------------------
AI_RAG_RERANK_MAX_LIMIT=8
AI_RAG_MMR_LAMBDA=0.74
AI_RAG_MMR_SAME_REEL_PENALTY=0.22
AI_RAG_MMR_TEMPORAL_OVERLAP_PENALTY=0.70

# -----------------------------------------------------------------------------
# Long-term memory
# -----------------------------------------------------------------------------
AI_USER_MEMORY_EMBEDDINGS_ENABLED=true
AI_USER_MEMORY_EMBEDDING_DIMENSIONS=384
AI_USER_MEMORY_DEDUPE_SEMANTIC_SCORE=0.94
AI_USER_MEMORY_DEDUPE_LEXICAL_SCORE=0.55

# -----------------------------------------------------------------------------
# Scene-change + periodic visual/OCR sampling
# -----------------------------------------------------------------------------
MEDIA_VISUAL_PERIODIC_INTERVAL_SECONDS=4
MEDIA_VISUAL_SCENE_THRESHOLD=0.35
MEDIA_VISUAL_DEDUPE_WINDOW_MS=750
MEDIA_VISUAL_MAX_FRAMES=24
MEDIA_VISUAL_FRAME_EXTRACTION_TIMEOUT_MS=180000

# Cloudflare vision model and request guard.
CLOUDFLARE_AI_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
AI_VISION_MAX_IMAGE_BYTES=4194304

# Visual indexing behavior.
INDEX_VISUAL_ANALYSIS_ENABLED=true
# Keep false so a temporary vision-provider failure does not block transcript
# and metadata indexing.
INDEX_VISUAL_ANALYSIS_REQUIRED=false
INDEX_VISUAL_ANALYSIS_CONCURRENCY=2
